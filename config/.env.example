# SIRH — modèle de configuration locale (copier vers config/.env, JAMAIS commité)
APP_NAME=SIRH
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca
APP_LOCALE=fr

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sirh
DB_USERNAME=root
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

SESSION_LIFETIME=120
UPLOAD_MAX_MB=10

# DB_SOCKET : option sandbox/dev (socket unix). Laisser vide sur WampServer Windows.
DB_SOCKET=
